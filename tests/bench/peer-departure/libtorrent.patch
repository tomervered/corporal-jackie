+		// A later verified piece is evidence that sequential playback has a hole.
+		// Use at most one backup copy per outstanding block in the first such piece.
+		if (t.is_sequential_download() && !c.on_parole() && !c.has_peer_choked())
+		{
+			auto front = p.cursor();
+			while (front < p.reverse_cursor() && p.have_piece(front)) ++front;
+			if (front < p.reverse_cursor() && (*bits)[front]
