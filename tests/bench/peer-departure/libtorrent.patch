+			{
+				bool passed_later = false;
+				for (auto i = next(front); i < p.reverse_cursor() && int(i) - int(front) <= 8; ++i)
+					if (p.have_piece(i)) { passed_later = true; break; }
+				if (passed_later)
+				{
+					for (int idx = 0; idx < p.blocks_in_piece(front) && num_requests > 0; ++idx)
+					{
+						piece_block const block(front, idx);
+						if (!p.is_requested(block) || p.num_peers(block) != 1) continue;
+						if (std::find_if(dq.begin(), dq.end(), aux::has_block(block)) != dq.end()) continue;
+						if (std::find_if(rq.begin(), rq.end(), aux::has_block(block)) != rq.end()) continue;
+						if (c.add_request(block, peer_connection::busy | peer_connection::time_critical))
+							--num_requests;
+					}
+					if (num_requests == 0) return true;
+				}
+			}
+		}
